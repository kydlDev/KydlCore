{
  "name": "hub-lists-ported-mods",
  "description": "Row 1 of the hub shows every installed KydlDev mod; every mod has at least one tab (its own or the automatic Settings)",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "kc.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "hook",
      "name": "kc.hubOpen"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "kc.hubMods",
      "contains": "com.kydldev.KydlCore",
      "label": "KydlCore"
    },
    {
      "do": "hook",
      "name": "kc.hubMods",
      "contains": "com.kydldev.chestdecor",
      "label": "ChestDecor"
    },
    {
      "do": "hook",
      "name": "kc.hubMods",
      "contains": "com.kydldev.WhipItUp",
      "label": "WhipItUp"
    },
    {
      "do": "hook",
      "name": "kc.hubMods",
      "contains": "com.kydldev.SteveTheTroll",
      "label": "SteveTheTroll"
    },
    {
      "do": "hook",
      "name": "kc.hubTabsAtLeast",
      "args": {
        "mod": "com.kydldev.KydlCore",
        "min": 1
      },
      "expect": true,
      "label": "at least 1 tab(s): com.kydldev.KydlCore"
    },
    {
      "do": "hook",
      "name": "kc.hubTabsAtLeast",
      "args": {
        "mod": "com.kydldev.chestdecor",
        "min": 1
      },
      "expect": true,
      "label": "at least 1 tab(s): com.kydldev.chestdecor"
    },
    {
      "do": "hook",
      "name": "kc.hubTabsAtLeast",
      "args": {
        "mod": "com.kydldev.WhipItUp",
        "min": 2
      },
      "expect": true,
      "label": "viewer + details"
    },
    {
      "do": "hook",
      "name": "kc.hubTabsAtLeast",
      "args": {
        "mod": "com.kydldev.SteveTheTroll",
        "min": 3
      },
      "expect": true,
      "label": "at least 3 tab(s): com.kydldev.SteveTheTroll"
    },
    {
      "do": "hook",
      "name": "kc.hubHasTab",
      "args": {
        "mod": "com.kydldev.KydlCore",
        "tab": "settings"
      },
      "expect": true,
      "label": "KydlCore has Settings"
    },
    {
      "do": "hook",
      "name": "kc.hubClose"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "KydlCore"
    }
  ]
}