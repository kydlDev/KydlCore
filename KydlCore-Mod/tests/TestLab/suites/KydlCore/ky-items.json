{
  "name": "ky-items",
  "description": "The KY-Items registry is ready and holds the items of the installed KydlDev mods WhipItUp is switched on for this test, so a leftover setting of another mod cannot decide it.",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "kc.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "setConfig",
      "guid": "com.kydldev.WhipItUp",
      "section": "General",
      "key": "Enable Mod",
      "value": true,
      "label": "WhipItUp on for this test (2026-11-23 k112g16-1: its Enable Mod was left false in the test profile, so it had no items; restored after the test)"
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "kc.itemsReady",
        "args": {},
        "expect": true
      },
      "timeout": 15
    },
    {
      "do": "hook",
      "name": "kc.itemsAtLeast",
      "args": {
        "min": 21,
        "mod": "com.kydldev.WhipItUp"
      },
      "label": "21 weapons",
      "expect": true
    },
    {
      "do": "hook",
      "name": "kc.itemsAtLeast",
      "label": "all mods",
      "args": {
        "min": 21
      },
      "expect": true
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "KydlCore"
    }
  ]
}